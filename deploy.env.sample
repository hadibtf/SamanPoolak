# Copy this file to "deploy.env" and fill in your values.
# deploy.env is gitignored — never commit real credentials.

# FTP host (bare hostname, no ftp:// and no port)
FTP_SERVER=hadibtf.ir

# FTP / cPanel account username
FTP_USER=hadibt

# FTP / cPanel password
FTP_PASSWORD=changeme

# Remote doc-root dirs, relative to the FTP login's home directory. Each
# subdomain has its own short doc-root dir: platform.samanpoolak.ir -> platform/,
# api.samanpoolak.ir -> api/. The marketing/landing site lives at the
# samanpoolak.ir root (doc-root dir "samanpoolak.ir").
FTP_WEB_DIR=platform
FTP_API_DIR=api
FTP_LANDING_DIR=samanpoolak.ir
FTP_JOBS_DIR=jobs
FTP_EMPLOYEE_DIR=employee

# API base URL baked into the front-end build at deploy time (its own subdomain).
API_URL=https://api.samanpoolak.ir

# Optional local folder for manual zip packages.
# MANUAL_PACKAGE_DIR=deploy-manual
